---
// ADC-IMPLEMENTS: <stubs-feature-dnd-02>
//
// D&D section stub at /dnd/. Navigable placeholder, shell-layout-framed.
// The stub also surfaces the preserved virtual-tabletop tool at
// /dnd-tabletop/ per the coordination clause in <stubs-feature-dnd-02> and
// the URL-preservation contract <stubs-feature-dnd-tabletop-passthrough-03>.
//
// The redesign of the full D&D section is a later ADC pass.
import ShellLayout from "../../layouts/ShellLayout.astro";
---

<ShellLayout title="D&D — milodowling.com">
  <section class="stub">
    <h1 class="stub-title">D&amp;D</h1>
    <p class="stub-copy">
      In development. The full D&amp;D section lands in its own ADC pass.
    </p>
    <p class="stub-copy">
      The existing virtual-tabletop tool is preserved at
      <a class="stub-link" href="/dnd-tabletop/">/dnd-tabletop/</a> and
      continues to serve unchanged across the rebuild.
    </p>
  </section>
</ShellLayout>

<style>
  /* Scoped to this page by Astro; no leakage into shell or other sections. */

  .stub {
    padding: clamp(3rem, 8vw, 5rem) var(--shell-gutter);
    max-width: 40rem;
    margin: 0 auto;
  }

  .stub-title {
    font-family: var(--shell-font-mono);
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    color: var(--shell-fg);
    letter-spacing: -0.01em;
  }

  .stub-copy {
    margin-top: 1rem;
    color: var(--shell-fg-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .stub-link {
    color: var(--shell-fg);
    text-decoration: underline;
    text-decoration-color: var(--shell-accent);
  }

  .stub-link:hover,
  .stub-link:focus-visible {
    color: var(--shell-accent);
  }
</style>
