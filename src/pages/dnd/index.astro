---
// ADC-IMPLEMENTS: <dnd-feature-landing-06>
//
// D&D section landing at /dnd/. Shell-layout-framed, copy + link only —
// the tool itself lives at /dnd-tabletop/ (its original, shared URL) and
// serves standalone per <dnd-feature-tool-route-01> in
// contracts/ADC_006_DND_TABLETOP.md.
import ShellLayout from "../../layouts/ShellLayout.astro";
---

<ShellLayout title="D&D — milodowling.com">
  <section class="stub">
    <h1 class="stub-title">D&amp;D</h1>
    <p class="stub-copy">
      A virtual tabletop for our sessions: upload a map, drop tokens on it,
      draw markers, toggle a grid — and share a table so everyone sees the
      same board live.
    </p>
    <p class="stub-copy">
      Open the tabletop at
      <a class="stub-link" href="/dnd-tabletop/">/dnd-tabletop/</a>.
      To play together, hit “Start shared table” and send the invite link.
    </p>
  </section>
</ShellLayout>

<style>
  /* Scoped to this page by Astro; no leakage into shell or other sections. */

  .stub {
    padding: clamp(3rem, 8vw, 5rem) var(--shell-gutter);
    max-width: 40rem;
    margin: 0 auto;
  }

  .stub-title {
    font-family: var(--shell-font-mono);
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    color: var(--shell-fg);
    letter-spacing: -0.01em;
  }

  .stub-copy {
    margin-top: 1rem;
    color: var(--shell-fg-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .stub-link {
    color: var(--shell-fg);
    text-decoration: underline;
    text-decoration-color: var(--shell-accent);
  }

  .stub-link:hover,
  .stub-link:focus-visible {
    color: var(--shell-accent);
  }
</style>
