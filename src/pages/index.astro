</ShellLayout>

<style>
  .phase1-placeholder {
    padding: clamp(2rem, 8vw, 5rem) var(--shell-gutter);
    max-width: var(--shell-measure);
  }

  .phase1-placeholder h1 {
    font-family: var(--shell-font-mono);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    letter-spacing: -0.01em;
  }

  .phase1-placeholder p {
    margin-top: 1rem;
    color: var(--shell-fg-muted);
  }
</style>
