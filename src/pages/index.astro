---
// Phase 1 placeholder homepage. Real hero + engine slot land in Phase 2 per
// <home-feature-homepage-01>, <home-feature-engine-slot-02>, and
// <home-impl-placeholder-04> in contracts/ADC_003_HOMEPAGE_AND_ENGINE_SLOT.md.
//
// This page exists solely to satisfy the Phase 1 roadmap item "Cloudflare
// Pages build/deploy config such that a static placeholder ships." It will
// be replaced wholesale in Phase 2.
import ShellLayout from "../layouts/ShellLayout.astro";
---

<ShellLayout title="milodowling.com">
  <section class="phase1-placeholder">
    <h1>milodowling.com</h1>
    <p>
      Shell rebuild in progress. Hero and engine slot land in Phase 2.
    </p>
